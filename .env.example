# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า (ห้ามอัปโหลดขึ้น GitHub หรือส่งให้ใคร)
# บนโฮสต์: ใส่ค่าเหล่านี้ในแท็บ "สภาพแวดล้อม" ทีละตัวแทนก็ได้

# --- Discord (จำเป็น) ---
DISCORD_TOKEN=
GUILD_ID=

# --- ห้อง log (เปิด Developer Mode > คลิกขวาที่ห้อง > Copy Channel ID) เว้นว่างได้ ---
WELCOME_CHANNEL_ID=
LOG_MEMBER_CHANNEL_ID=
LOG_MESSAGE_CHANNEL_ID=
LOG_VOICE_CHANNEL_ID=
LOG_MOD_CHANNEL_ID=

# --- ห้องที่บอทโพสต์ข้อความให้คนอ่าน เว้นว่างได้ (ไม่ตั้ง = โพสต์ในห้องที่พิมพ์คำสั่ง) ---
ANNOUNCE_CHANNEL_ID=
NOTICE_CHANNEL_ID=
PUNISH_CHANNEL_ID=

# --- แฟม ---
FAMILY_NAME=สุภาพสตรี
FAMILY_TAG=สตรี
# true = ตั้งชื่อเล่นสมาชิกใหม่เป็น [สตรี] ชื่อ อัตโนมัติ (คนเก่าใช้คำสั่ง /จัดชื่อแฟม)
AUTO_NICKNAME=false
# ยศที่ให้สมาชิกใหม่อัตโนมัติ เช่น ยศ member (ใส่ไอดียศ เว้นว่าง = ไม่ให้)
AUTO_ROLE_ID=

# --- ยศ (ไอดียศ คั่นด้วยคอมมา ดูรายการไอดีได้ด้วยคำสั่ง /ยศทั้งหมด) ---
# ยศที่ใช้คำสั่งผู้ดูแลได้ (/ประกาศ /ลงโทษ /แบน /ปลดแบน /ประวัติ /ปักผังแฟม /จัดชื่อแฟม /ยศทั้งหมด)
# เว้นว่าง = ใช้ค่าเริ่มต้น: หัวแฟม, ผู้คุมกฎ, รองหัว, บอท
ADMIN_ROLE_IDS=
# ยศที่แสดงในผังแฟม เรียงจากสูงไปต่ำ เว้นว่าง = ใช้ค่าเริ่มต้น: หัวแฟม, ผู้คุมกฎ, รองหัว
CHART_ROLE_IDS=

# --- Supabase (ใช้ Secret key เก็บไว้ฝั่งเซิร์ฟเวอร์เท่านั้น) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
